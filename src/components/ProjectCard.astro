---
export interface Props {
  title: string;
  description: string;
  date: Date;
  span?: string;
  slug: string;
  index?: number;
  tags?: string[];
  stars?: number;
  repoUrl?: string;
  demoUrl?: string;
  icon?: string;
}

const {
  title,
  description,
  span,
  slug,
  index = 1,
  tags = [],
  icon
} = Astro.props;

const number = String(index).padStart(2, '0');
---

<article class="project-row">
  <a class="project-row-link" href={`/projects/${slug}`} aria-label={`View ${title}`}>
    <div class="project-icon-wrap">
      {icon && (
  <img
    src={icon}
    alt=""
    class="project-icon"
    width="56"
    height="56"
  />
)}
    </div>

    <div class="project-number">{number}</div>

    <div class="project-body">
      <div class="project-heading">
        <span class="project-title">{title}</span>
        {span && <span class="project-span">{span}</span>}
      </div>

      <p class="project-desc">{description}</p>

      {tags.length > 0 && (
        <div class="project-tags">
          {tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    <span class="project-arrow" aria-hidden="true">→</span>
  </a>
</article>

<style is:global>
  .project-row {
    margin: 0;
    background: var(--bg-surface);
  }

  .project-row + .project-row {
    border-top: 3px solid var(--text);
  }

  .project-row-link {
    display: grid;
    grid-template-columns: 88px 34px minmax(0, 1fr) 28px;
    gap: 0.9rem;
    align-items: center;
    padding: 1.6rem 1.4rem;
    color: var(--text);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .project-row-link:hover {
    background: var(--bg-subtle);
    color: var(--text);
  }

  .project-icon-wrap {
    width: 78px;
    height: 78px;
    border: 3px solid var(--text);
    background: var(--bg);
    padding: 6px;
    box-shadow: 6px 6px 0 var(--text);
  }

  .project-icon {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 8px;
  }

  .project-number {
    padding-top: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .project-body {
    min-width: 0;
  }

  .project-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px;
    gap: 1rem;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    min-height: 34px;
  }

  .project-title {
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .project-row-link:hover .project-title {
    color: var(--accent);
  }


  .project-span {
    width: 150px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
    text-align: left;
    justify-self: end;
  }

  .project-desc {
    max-width: 760px;
    margin: 0.7rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.8rem;
  }

  .tag {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .project-arrow {
    padding-top: 0.25rem;
    justify-self: end;
    font-size: 1.35rem;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .project-row-link {
      grid-template-columns: 58px 30px minmax(0, 1fr);
      gap: 0.75rem;
      padding: 1rem;
    }

    .project-icon-wrap {
      width: 52px;
      height: 52px;
      padding: 4px;
      box-shadow: 4px 4px 0 var(--text);
    }

    .project-icon {
      font-size: 1.35rem;
    }

    .project-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }

    .project-title {
      font-size: 1.15rem;
    }

    .project-arrow {
      display: none;
    }
  }
</style>

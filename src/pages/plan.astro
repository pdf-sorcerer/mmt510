---

<BaseLayout
  title=".plan"
  description="Reverse-chronological build history for Mason Thompson's local AI, multimodal, and product systems."
>
  <main class="plan-page">
    <header class="plan-header">
      <p class="eyebrow">PROJECT HISTORY</p>
      <h1>.plan</h1>
      <p class="lede">
        Reverse-chronological reconstruction of the systems I've been building.
        Current pass is primarily PC-source evidence; Mac/Hibi history will be layered in next.
      </p>
    </header>

    <div class="timeline">
      {months.map((month) => (
        <section class="month-block">
          <header class="month-header">
            <div>
              <div class="month-date">{month.month}</div>
              <h2>{month.title}</h2>
            </div>
            <span class="source-tag">[{month.source.toLowerCase()}]</span>
          </header>

          {month.intro && <p class="month-intro">{month.intro}</p>}

          {month.entries.map((entry) => (
            <article class="entry">
              <div class="entry-date">{entry.date}</div>
              <div class="entry-body">
                <h3>{entry.title}</h3>
                {entry.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          ))}
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .plan-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.25rem 0 5rem;
  }

  .plan-header {
    max-width: 760px;
    margin-bottom: 3.5rem;
  }

  .eyebrow,
  .month-date,
  .entry-date,
  .source-tag {
    font-family: var(--font-mono);
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .plan-header h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.3rem);
    line-height: 1;
  }

  .lede {
    max-width: 720px;
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .month-block {
    padding: 0 0 3.25rem;
    margin: 0 0 3.25rem;
    border-bottom: 1px solid var(--border);
  }

  .month-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .month-date {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: 0.4rem;
  }

  .month-header h2 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .source-tag {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  .month-intro {
    max-width: 760px;
    margin: 0.25rem 0 1.5rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .entry {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.35rem 0;
    border-top: 1px solid var(--border);
  }

  .entry-date {
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.5;
    padding-top: 0.15rem;
  }

  .entry-body h3 {
    margin: 0 0 0.45rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  .entry-body p {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .plan-page {
      padding-top: 1.25rem;
    }

    .month-header {
      display: block;
    }

    .source-tag {
      display: inline-block;
      margin-top: 0.6rem;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>

<style>
  :global(header a[href="/plan"]),
  :global(header a[href="/plan"]:visited),
  :global(header a[href="/plan"][aria-current="page"]) {
    font: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    letter-spacing: inherit !important;
    color: inherit !important;
  }
</style>

  }
}
</style>

<style is:global>
.training-calendar details.calendar-day[open] > summary {
  background: color-mix(in srgb, #fc4c02 10%, var(--background)) !important;
  box-shadow:
    inset 0 0 0 2px rgba(252, 76, 2, 0.55);
}

.training-calendar details.calendar-day[open] .calendar-date {
  color: var(--text);
  font-weight: 800;
}
</style>

<script is:inline>
(() => {
  if (window.__trainingCalendarPopoverInit) return;
  window.__trainingCalendarPopoverInit = true;

  const calendar = document.querySelector('.training-calendar');
  if (!calendar) return;

  const days = Array.from(
    calendar.querySelectorAll('details.calendar-day-active')
  );

  // Only one date may be open at a time.
  days.forEach((day) => {
    day.addEventListener('toggle', () => {
      if (!day.open) return;

      days.forEach((other) => {
        if (other !== day) {
          other.open = false;
        }
      });
    });
  });

  // Clicking anywhere outside the currently open date closes it.
  document.addEventListener('pointerdown', (event) => {
    const openDay = calendar.querySelector(
      'details.calendar-day-active[open]'
    );

    if (!openDay) return;

    if (!openDay.contains(event.target)) {
      openDay.open = false;
    }
  });
})();
</script>

<div class="strava-confirm" hidden>
  <div class="strava-confirm-card" role="dialog" aria-modal="true" aria-labelledby="strava-confirm-title">
    <strong id="strava-confirm-title">Open this activity on Strava?</strong>

    <div class="strava-confirm-actions">
      <button type="button" class="strava-confirm-cancel">Cancel</button>
      <a class="strava-confirm-go" href="#" target="_blank" rel="noopener noreferrer">
        Go to Strava ↗
      </a>
    </div>
  </div>
</div>

<style is:global>
.calendar-popover .calendar-activity-link {
  display: grid;
  width: 100%;
  gap: 0.08rem;
  padding: 0.72rem 0.82rem;
  border: 0;
  border-radius: 0;
  background: #f7f1e4;
  color: inherit;
  text-align: left;
  cursor: pointer;
  font: inherit;
}

.calendar-popover .calendar-activity-link + .calendar-activity-link {
  border-top: 1px solid var(--border);
}

.calendar-popover .calendar-activity-link:hover {
  background: color-mix(in srgb, var(--border) 22%, #f7f1e4);
}

.calendar-popover .calendar-activity-link strong {
  color: var(--text);
  font-size: 0.76rem;
}

.calendar-popover .calendar-activity-link span {
  font-family: var(--font-mono);
  font-size: 0.63rem;
  color: var(--text-muted);
}

.strava-confirm {
  position: fixed;
  inset: 0;
  z-index: 20000;
  display: grid;
  place-items: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.28);
}

.strava-confirm[hidden] {
  display: none;
}

.strava-confirm-card {
  width: min(340px, 92vw);
  padding: 1rem;
  border-radius: 12px;
  background: #f7f1e4;
  outline: 2px solid rgba(0, 0, 0, 0.45);
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.5),
    0 12px 30px rgba(0, 0, 0, 0.28);
}

.strava-confirm-card strong {
  display: block;
  color: var(--text);
  font-size: 0.95rem;
}

.strava-confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.6rem;
  margin-top: 1rem;
}

.strava-confirm-actions button,
.strava-confirm-actions a {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  padding: 0.45rem 0.75rem;
  border-radius: 8px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  text-decoration: none;
}

.strava-confirm-cancel {
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  cursor: pointer;
}

.strava-confirm-go {
  border: 1px solid rgba(252, 76, 2, 0.5);
  background: color-mix(in srgb, #fc4c02 10%, #f7f1e4);
  color: var(--text);
}
</style>

<script is:inline>
(() => {
  if (window.__stravaConfirmInit) return;
  window.__stravaConfirmInit = true;

  const confirm = document.querySelector('.strava-confirm');
  const cancel = document.querySelector('.strava-confirm-cancel');
  const go = document.querySelector('.strava-confirm-go');

  if (!confirm || !cancel || !go) return;

  document.addEventListener('click', (event) => {
    const button = event.target.closest('.calendar-activity-link');
    if (!button) return;

    event.preventDefault();
    event.stopPropagation();

    const url = button.dataset.stravaUrl;
    if (!url) return;

    go.href = url;
    confirm.hidden = false;
  });

  cancel.addEventListener('click', () => {
    confirm.hidden = true;
    go.href = '#';
  });

  confirm.addEventListener('click', (event) => {
    if (event.target === confirm) {
      confirm.hidden = true;
      go.href = '#';
    }
  });

  go.addEventListener('click', () => {
    confirm.hidden = true;
  });
})();
</script>

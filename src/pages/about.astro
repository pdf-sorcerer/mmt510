---
import BaseLayout from '../layouts/BaseLayout.astro';
import strava from '../data/strava.json';

const activities = strava.activities.slice(0, 6);

const formatTime = (seconds: number) => {
  if (!seconds) return '—';

  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  const s = Math.floor(seconds % 60);

  if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  return `${m}:${String(s).padStart(2, '0')}`;
};

const formatPace = (seconds: number | null) => {
  if (!seconds) return null;

  const m = Math.floor(seconds / 60);
  const s = Math.round(seconds % 60);

  return `${m}:${String(s).padStart(2, '0')}/100 yd`;
};

const formatDate = (value: string | null) => {
  if (!value) return '';

  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(value));
};

const formatSport = (sport: string) => {
  const names: Record<string, string> = {
    Swim: 'Swim',
    Ride: 'Ride',
    MountainBikeRide: 'Mountain bike',
    GravelRide: 'Gravel ride',
    Hike: 'Hike',
    Walk: 'Walk',
    Run: 'Run',
  };

  return names[sport] ?? sport;
};
---

<BaseLayout
  title="About"
  description="About Mason Thompson — product manager, builder, and lifelong tinkerer."
>
  <article class="about-page">
    <header class="about-header">
      <h1 class="page-title">About</h1>
    </header>

    <div class="about-content">
      <p>
        I've been building and tinkering with computers and electronics for most of my life.
        As a kid, that mostly meant computer gaming—but even then, I was in terminals testing
        settings and trying to squeeze out more performance. Outside of tech, my interests
        include aviation, biology, astronomy, and spending time outdoors cycling, swimming,
        and hiking.
      </p>

      <h2>How I work</h2>

      <p>
        I'm a bottom-up thinker and fairly technical for a product manager. My career has
        largely been in SaaS startups like Zenefits and Ease, working on HRIS platforms,
        employee benefits, and ways to automate tedious paperwork and operational workflows.
      </p>

      <p>
        After my last company was acquired in early 2022, I spent time retooling around
        generative AI and learning the technology by building with it directly. That work
        now spans local LLM infrastructure, speech recognition and diarization, multimodal
        interfaces, cryptography, observability, and human-in-the-loop systems.
      </p>

      <h2>Where I'm based</h2>

      <p>
        A surprising number of interviews in 2026 have asked where I'm based. I've linked
        my Strava profile as a simple way to show that I live and exercise in Oakland,
        Berkeley, and the surrounding areas.
      </p>

      <section class="training">
        <div class="training-heading">
          <h2>Training lately</h2>

          <a
            href={strava.athlete.profile_url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Strava ↗
          </a>
        </div>

        {activities.length > 0 ? (
          <div class="activity-list">
            {activities.map((activity) => (
              <a
                class="activity"
                href={activity.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="activity-top">
                  <strong>{activity.name}</strong>
                  <span>{formatDate(activity.date)}</span>
                </div>

                <div class="activity-meta">
                  <span>{formatSport(activity.sport_type)}</span>

                  {activity.sport_type === 'Swim' ? (
                    <>
                      <span>{activity.distance_yards.toLocaleString()} yd</span>
                      <span>{formatTime(activity.moving_time)}</span>

                      {activity.pace_100yd_seconds && (
                        <span>{formatPace(activity.pace_100yd_seconds)}</span>
                      )}

                      {activity.laps !== null && (
                        <span>{activity.laps} laps</span>
                      )}
                    </>
                  ) : (
                    <>
                      <span>{activity.distance_miles.toFixed(2)} mi</span>
                      <span>{formatTime(activity.moving_time)}</span>
                    </>
                  )}

                  {activity.average_heartrate && (
                    <span>{Math.round(activity.average_heartrate)} bpm</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="training-empty">
            Recent activity will appear here after the next deployment.
          </p>
        )}
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .about-page {
    padding-top: 1rem;
    max-width: 780px;
  }

  .about-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    margin: 0;
    font-size: 1.65rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .about-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .about-content p {
    margin: 0 0 1.4rem;
  }

  .about-content h2 {
    margin: 2.4rem 0 0.8rem;
    font-size: 1.25rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .training {
    margin-top: 2.5rem;
  }

  .training-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.7rem;
    margin-bottom: 0;
  }

  .training-heading h2 {
    margin: 0;
  }

  .training-heading a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .activity-list {
    display: grid;
  }

  .activity {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }

  .activity:hover strong {
    text-decoration: underline;
  }

  .activity-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }

  .activity-top strong {
    color: var(--text);
    font-size: 0.98rem;
  }

  .activity-top > span {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    white-space: nowrap;
    color: var(--text-muted);
  }

  .activity-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .training-empty {
    padding: 1rem 0;
    font-size: 0.9rem;
  }

  @media (max-width: 700px) {
    .about-page {
      padding-top: 0.5rem;
    }

    .about-content {
      font-size: 1rem;
      line-height: 1.65;
    }

    .activity-top {
      display: block;
    }

    .activity-top > span {
      display: block;
      margin-top: 0.1rem;
    }
  }
</style>

<script>
  function initGhostMobileTOC() {
    const nav = document.querySelector('.ghost-mobile-toc');
    if (!nav) return;

    const current = nav.querySelector('.ghost-mobile-toc-current');
    const details = nav.querySelector('details');
    const links = Array.from(nav.querySelectorAll('a[href^="#"]'));

    if (!(current instanceof HTMLElement) || !(details instanceof HTMLDetailsElement) || !links.length) return;

    const targets = links
      .map((link) => {
        const id = link.getAttribute('href')?.slice(1);
        const heading = id ? document.getElementById(id) : null;
        return heading ? { link, heading } : null;
      })
      .filter(Boolean);

    if (!targets.length) return;

    const setActive = (item) => {
      targets.forEach(({ link }) => link.classList.remove('active'));
      item.link.classList.add('active');
      current.textContent = item.link.textContent?.trim() || '';
    };

    const update = () => {
      const activationPoint = Math.max(120, window.innerHeight * 0.28);
      let active = targets[0];

      for (const item of targets) {
        if (item.heading.getBoundingClientRect().top <= activationPoint) {
          active = item;
        } else {
          break;
        }
      }

      setActive(active);
    };

    links.forEach((link) => {
      link.addEventListener('click', () => {
        details.open = false;
      });
    });

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }

  initGhostMobileTOC();
  document.addEventListener('astro:page-load', initGhostMobileTOC);
  document.addEventListener('astro:after-swap', initGhostMobileTOC);
</script>


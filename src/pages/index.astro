---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';

const allProjects = await getCollection('projects');

const projects = allProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Mason Thompson</p>

    <h1 class="hero-title">
      Product Manager &amp; AI Systems Builder
    </h1>

    <p class="hero-subtitle">
      I build product systems spanning local AI, workflow automation,
      multimodal interfaces, and applied AI infrastructure.
    </p>

    <div class="hero-actions">
      <a href="/projects" class="text-link">View projects →</a>
      <a href="/about" class="text-link">About</a>
    </div>
  </section>

  <section class="projects-section">
    <div class="section-header">
      <h2>Selected Work</h2>
    </div>

    <div class="projects-list">
      {projects.map((proj) => (
        <ProjectCard
          title={proj.data.title}
          description={proj.data.description}
          date={proj.data.date}
          slug={proj.id}
          tags={proj.data.tags}
          stars={proj.data.stars}
          repoUrl={proj.data.repoUrl}
          demoUrl={proj.data.demoUrl}
          category={proj.data.category}
          emoji={proj.data.emoji}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .hero-title {
    margin: 0;
    max-width: 760px;
    font-size: 2.6rem;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .hero-subtitle {
    max-width: 680px;
    margin: 1.25rem 0 0;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .text-link {
    font-weight: 500;
    text-decoration: none;
  }

  .projects-section {
    padding-bottom: 2rem;
  }

  .section-header {
    margin-bottom: 1.25rem;
  }

  .section-header h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 700px) {
    .hero-title {
      font-size: 2.1rem;
    }

    .hero {
      padding-top: 2rem;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import strava from '../data/strava.json';

const activities = strava.activities.slice(0, 6);

const formatTime = (seconds: number) => {
  if (!seconds) return '—';

  const h = Math.floor(seconds / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  const s = Math.floor(seconds % 60);

  if (h > 0) {
    return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  return `${m}:${String(s).padStart(2, '0')}`;
};

const formatPace = (seconds: number | null | undefined) => {
  if (!seconds) return '—';

  const m = Math.floor(seconds / 60);
  const s = Math.round(seconds % 60);

  return `${m}:${String(s).padStart(2, '0')}`;
};

const formatDate = (value: string | null) => {
  if (!value) return '';

  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(value));
};

const formatSport = (sport: string) => {
  const names: Record<string, string> = {
    Swim: 'Swim',
    Ride: 'Ride',
    MountainBikeRide: 'Mountain bike',
    GravelRide: 'Gravel ride',
    Hike: 'Hike',
    Walk: 'Walk',
    Run: 'Run',
  };

  return names[sport] ?? sport;
};

const sportIcon = (sport: string) => {
  switch (sport) {
    case 'Swim':
      return '≈';
    case 'Walk':
    case 'Hike':
      return '↟';
    case 'Run':
      return '↗';
    case 'Ride':
    case 'MountainBikeRide':
    case 'GravelRide':
      return '◉';
    default:
      return '•';
  }
};

type Point = {
  lat: number;
  lng: number;
};

const decodePolyline = (encoded?: string | null): Point[] => {
  if (!encoded) return [];

  const points: Point[] = [];

  let index = 0;
  let lat = 0;
  let lng = 0;

  while (index < encoded.length) {
    let shift = 0;
    let result = 0;
    let byte = 0;

    do {
      byte = encoded.charCodeAt(index++) - 63;
      result |= (byte & 0x1f) << shift;
      shift += 5;
    } while (byte >= 0x20 && index < encoded.length);

    const deltaLat = result & 1 ? ~(result >> 1) : result >> 1;
    lat += deltaLat;

    shift = 0;
    result = 0;

    do {
      byte = encoded.charCodeAt(index++) - 63;
      result |= (byte & 0x1f) << shift;
      shift += 5;
    } while (byte >= 0x20 && index < encoded.length);

    const deltaLng = result & 1 ? ~(result >> 1) : result >> 1;
    lng += deltaLng;

    points.push({
      lat: lat / 1e5,
      lng: lng / 1e5,
    });
  }

  return points;
};

const routePath = (encoded?: string | null) => {
  const points = decodePolyline(encoded);

  if (points.length < 2) {
    return null;
  }

  const minLat = Math.min(...points.map((p) => p.lat));
  const maxLat = Math.max(...points.map((p) => p.lat));
  const minLng = Math.min(...points.map((p) => p.lng));
  const maxLng = Math.max(...points.map((p) => p.lng));

  const latSpan = Math.max(maxLat - minLat, 0.000001);
  const lngSpan = Math.max(maxLng - minLng, 0.000001);

  const width = 700;
  const height = 260;
  const padding = 26;

  const usableWidth = width - padding * 2;
  const usableHeight = height - padding * 2;

  const scale = Math.min(
    usableWidth / lngSpan,
    usableHeight / latSpan
  );

  const renderedWidth = lngSpan * scale;
  const renderedHeight = latSpan * scale;

  const xOffset = (width - renderedWidth) / 2;
  const yOffset = (height - renderedHeight) / 2;

  const projected = points.map((point) => ({
    x: xOffset + (point.lng - minLng) * scale,
    y: yOffset + (maxLat - point.lat) * scale,
  }));

  const path = projected
    .map(
      (point, index) =>
        `${index === 0 ? 'M' : 'L'} ${point.x.toFixed(2)} ${point.y.toFixed(2)}`
    )
    .join(' ');

  return {
    path,
    start: projected[0],
    end: projected[projected.length - 1],
  };
};

const activityViews = activities.map((activity) => ({
  ...activity,
  route: routePath(activity.summary_polyline),
}));
---

<BaseLayout
  title="About"
  description="About Mason Thompson — product manager, builder, and lifelong tinkerer."
>
  <article class="about-page">
    <header class="about-header">
      <h1 class="page-title">About</h1>
    </header>

    <div class="about-content">
      <p>
        I've been building and tinkering with computers and electronics for most of my life.
        As a kid, that mostly meant computer gaming—but even then, I was in terminals testing
        settings and trying to squeeze out more performance. Outside of tech, my interests
        include aviation, biology, astronomy, and spending time outdoors cycling, swimming,
        and hiking.
      </p>

      <h2>How I work</h2>

      <p>
        I'm a bottom-up thinker and fairly technical for a product manager. My career has
        largely been in SaaS startups like Zenefits and Ease, working on HRIS platforms,
        employee benefits, and ways to automate tedious paperwork and operational workflows.
      </p>

      <p>
        After my last company was acquired in early 2022, I spent time retooling around
        generative AI and learning the technology by building with it directly. That work
        now spans local LLM infrastructure, speech recognition and diarization, multimodal
        interfaces, cryptography, observability, and human-in-the-loop systems.
      </p>

      <h2>Where I'm based</h2>

      <p>
        A surprising number of interviews in 2026 have asked where I'm based. I've linked
        my Strava profile as a simple way to show that I live and exercise in Oakland,
        Berkeley, and the surrounding areas.
      </p>

      <section class="training">
        <div class="training-heading">
          <div>
            <h2>Training lately</h2>
            <p>Recent activity from Strava.</p>
          </div>

          <a
            href={strava.athlete.profile_url}
            target="_blank"
            rel="noopener noreferrer"
          >
            View on Strava ↗
          </a>
        </div>

        {activityViews.length > 0 ? (
          <div class="activity-list">
            {activityViews.map((activity) => (
              <article class="activity-card">
                <a
                  class="activity-link"
                  href={activity.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${activity.name} on Strava`}
                >
                  <div class="activity-byline">
                    <div class="activity-avatar">
                      MT
                    </div>

                    <div class="activity-author">
                      <strong>Mason Thompson</strong>
                      <span>{formatDate(activity.date)}</span>
                    </div>

                    <span class="activity-arrow">↗</span>
                  </div>

                  <div class="activity-title-row">
                    <span class="sport-icon">
                      {sportIcon(activity.sport_type)}
                    </span>

                    <div>
                      <span class="sport-label">
                        {formatSport(activity.sport_type)}
                      </span>

                      <h3>{activity.name}</h3>
                    </div>
                  </div>

                  {activity.sport_type === 'Swim' ? (
                    <div class="activity-stats">
                      <div class="stat">
                        <strong>
                          {activity.distance_yards.toLocaleString()} yd
                        </strong>
                        <span>Distance</span>
                      </div>

                      <div class="stat">
                        <strong>{formatTime(activity.moving_time)}</strong>
                        <span>Moving time</span>
                      </div>

                      <div class="stat">
                        <strong>
                          {formatPace(activity.pace100yd_seconds)}
                        </strong>
                        <span>Per 100 yd</span>
                      </div>
                    </div>
                  ) : (
                    <div class="activity-stats">
                      <div class="stat">
                        <strong>
                          {activity.distance_miles.toFixed(2)} mi
                        </strong>
                        <span>Distance</span>
                      </div>

                      <div class="stat">
                        <strong>{formatTime(activity.moving_time)}</strong>
                        <span>Moving time</span>
                      </div>

                      <div class="stat">
                        <strong>
                          {activity.average_heartrate
                            ? `${Math.round(activity.average_heartrate)} bpm`
                            : '—'}
                        </strong>
                        <span>Avg. heart rate</span>
                      </div>
                    </div>
                  )}

                  {activity.summary_polyline && (
                    <div class="route-preview">
                      <div
                        class="strava-map"
                        data-polyline={activity.summary_polyline}
                        data-activity={activity.name}
                        aria-label={`GPS route map for ${activity.name}`}
                      ></div>

                      <div class="route-caption">
                        <span>GPS route</span>
                        <span>OpenStreetMap</span>
                      </div>
                    </div>
                  )}

                  <div class="activity-secondary">
                    {activity.sport_type === 'Swim' && activity.laps != null && (
                      <span>{activity.laps} laps</span>
                    )}

                    {activity.max_heartrate && (
                      <span>
                        max {Math.round(activity.max_heartrate)} bpm
                      </span>
                    )}

                    <span>Strava ↗</span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="training-empty">
            Recent activity will appear here after the next deployment.
          </p>
        )}
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .about-page {
    padding-top: 1rem;
    max-width: 780px;
  }

  .about-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    margin: 0;
    font-size: 1.65rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .about-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .about-content > p {
    margin: 0 0 1.4rem;
  }

  .about-content > h2 {
    margin: 2.4rem 0 0.8rem;
    font-size: 1.25rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .training {
    margin-top: 2.8rem;
  }

  .training-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .training-heading h2 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--text);
  }

  .training-heading p {
    margin: 0.15rem 0 0;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .training-heading a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .activity-list {
    display: grid;
    gap: 1.25rem;
  }

  .activity-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--background);
    outline: 2px solid rgba(0, 0, 0, 0.28);
    outline-offset: 0;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.45),
      0 6px 18px rgba(0, 0, 0, 0.10);
  }

  .activity-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .activity-byline {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.05rem 0.3rem;
  }

  .activity-avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 50%;
    background: var(--border);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .activity-author {
    min-width: 0;
    display: grid;
    line-height: 1.25;
  }

  .activity-author strong {
    color: var(--text);
    font-size: 0.83rem;
  }

  .activity-author span {
    margin-top: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .activity-arrow {
    margin-left: auto;
    color: var(--text-muted);
  }

  .activity-title-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.9rem 1.05rem 0.8rem;
  }

  .sport-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--border) 65%, transparent);
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .sport-label {
    display: block;
    margin-bottom: 0.05rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .activity-title-row h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.2rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .activity-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0.25rem 1.05rem 1rem;
  }

  .stat {
    min-width: 0;
    padding-right: 0.8rem;
  }

  .stat + .stat {
    padding-left: 0.8rem;
    border-left: 1px solid var(--border);
  }

  .stat strong {
    display: block;
    color: var(--text);
    font-size: 1.04rem;
    line-height: 1.2;
    font-weight: 750;
    white-space: nowrap;
  }

  .stat span {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    line-height: 1.2;
    color: var(--text-muted);
  }

  .route-preview {
    margin: 0.9rem 1rem 1rem;
    overflow: hidden;
    border-radius: 10px;
    outline: 3px solid rgba(0, 0, 0, 0.48);
    outline-offset: 0;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.55),
      0 5px 16px rgba(0, 0, 0, 0.18);
  }

  .strava-map {
    width: 100%;
    height: 290px;
    background: color-mix(in srgb, var(--border) 35%, transparent);
  }

  :global(.strava-map .leaflet-overlay-pane svg),
  :global(.strava-map .leaflet-pane svg) {
    width: auto !important;
    height: auto !important;
    max-width: none !important;
    max-height: none !important;
  }

  :global(.strava-map .leaflet-route-pane) {
    z-index: 650 !important;
  }

  .route-caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.75rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
  }

  .activity-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: 0.7rem 1.05rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    color: var(--text-muted);
  }

  .activity-secondary span:last-child {
    margin-left: auto;
  }

  .activity-link:hover .activity-title-row h3 {
    text-decoration: underline;
  }

  .training-empty {
    padding: 1rem 0;
    font-size: 0.9rem;
  }

  @media (max-width: 700px) {
    .about-page {
      padding-top: 0.5rem;
    }

    .about-content {
      font-size: 1rem;
      line-height: 1.65;
    }

    .training-heading {
      align-items: flex-start;
    }

    .activity-card {
      border-radius: 11px;
    }

    .activity-stats {
      padding-left: 0.9rem;
      padding-right: 0.9rem;
    }

    .stat {
      padding-right: 0.45rem;
    }

    .stat + .stat {
      padding-left: 0.45rem;
    }

    .stat strong {
      font-size: 0.92rem;
    }

    .strava-map {
      height: 220px;
    }
  }
</style>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script
  is:inline
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>

<script is:inline>
  (() => {
    function decodePolyline(encoded) {
      const points = [];
      let index = 0;
      let lat = 0;
      let lng = 0;

      while (index < encoded.length) {
        let shift = 0;
        let result = 0;
        let byte;

        do {
          byte = encoded.charCodeAt(index++) - 63;
          result |= (byte & 0x1f) << shift;
          shift += 5;
        } while (byte >= 0x20);

        lat += (result & 1) ? ~(result >> 1) : (result >> 1);

        shift = 0;
        result = 0;

        do {
          byte = encoded.charCodeAt(index++) - 63;
          result |= (byte & 0x1f) << shift;
          shift += 5;
        } while (byte >= 0x20);

        lng += (result & 1) ? ~(result >> 1) : (result >> 1);

        points.push([lat / 1e5, lng / 1e5]);
      }

      return points;
    }

    function initMaps() {
      if (!window.L) return;

      document.querySelectorAll('.strava-map').forEach((el) => {
        if (el.dataset.ready === '1') return;

        const encoded = el.dataset.polyline;
        if (!encoded) return;

        const points = decodePolyline(encoded);
        if (points.length < 2) return;

        const map = L.map(el, {
          zoomControl: true,
          attributionControl: true,
          scrollWheelZoom: false,
        });

        L.tileLayer(
          'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors',
          }
        ).addTo(map);

        map.createPane('routePane');
        map.getPane('routePane').style.zIndex = '650';
        map.getPane('routePane').style.pointerEvents = 'none';

        const route = L.polyline(points, {
          pane: 'routePane',
          color: '#fc4c02',
          weight: 6,
          opacity: 1,
          lineCap: 'round',
          lineJoin: 'round',
        }).addTo(map);

        L.circleMarker(points[0], {
          radius: 5,
          color: '#fc4c02',
          weight: 3,
          fillColor: '#ffffff',
          fillOpacity: 1,
        }).addTo(map);

        L.circleMarker(points[points.length - 1], {
          radius: 5,
          color: '#ffffff',
          weight: 2,
          fillColor: '#fc4c02',
          fillOpacity: 1,
        }).addTo(map);

        map.fitBounds(route.getBounds(), {
          padding: [24, 24],
        });

        el.dataset.ready = '1';
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMaps, { once: true });
    } else {
      initMaps();
    }
  })();
</script>
